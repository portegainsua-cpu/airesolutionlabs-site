---
// Plantilla común: <head> (SEO, Open Graph, iconos, fuentes), saltar al contenido, cabecera y pie.
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import '../styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta canónica, p. ej. "/" o "/aviso-legal.html". Sin ella no se genera canonical ni og:url. */
  ruta?: string;
  noindex?: boolean;
  jsonld?: object;
}
const { titulo, descripcion, ruta, noindex = false, jsonld } = Astro.props;
const canonica = ruta ? new URL(ruta, Astro.site).href : undefined;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {noindex && <meta name="robots" content="noindex">}
  <title>{titulo}</title>
  <meta name="description" content={descripcion}>
  {canonica && <link rel="canonical" href={canonica}>}
  {!noindex && (
    <>
      <meta property="og:type" content="website">
      <meta property="og:locale" content="es_ES">
      <meta property="og:site_name" content="AI Resolution Labs">
      <meta property="og:title" content={titulo}>
      <meta property="og:description" content={descripcion}>
      {canonica && <meta property="og:url" content={canonica}>}
      <meta name="twitter:card" content="summary">
      <meta name="twitter:title" content={titulo}>
      <meta name="twitter:description" content={descripcion}>
    </>
  )}
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)}></script>}
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#2347C5">
  <link rel="preload" href="/fonts/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  <Cabecera />
  <main id="contenido" tabindex="-1">
    <slot />
  </main>
  <Pie />
</body>
</html>
