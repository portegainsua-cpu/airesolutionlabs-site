---
// Botón de reserva de Cal.com. Abre el modal al primer clic (src/scripts/cal.js);
// si Cal.com no carga en 5 s, abre cal.com en una pestaña nueva.
// `evento`: ruta en Cal.com (usuario o usuario/evento, p. ej. el diagnóstico).
interface Props { clase?: string; evento?: string }
const { clase = 'boton boton--secundario-oscuro', evento = 'pablo-ortega-insua-wdoysa' } = Astro.props;
---
<a class={clase} href={`https://cal.com/${evento}`} target="_blank" rel="noopener" data-cal-booking={evento} data-cal-config='{"layout":"month_view"}'><slot /></a>

<script>
  import '../scripts/cal.js';
</script>
